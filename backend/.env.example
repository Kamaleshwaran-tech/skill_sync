ENVIRONMENT=development
DEBUG=false
APP_NAME=SkillSync
APP_VERSION=0.3.0
DATABASE_URL=sqlite:///./skillsync_ai.db
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_OR_USE_BOOTSTRAP
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
RESUME_STORAGE_DIR=./storage/resumes
RESUME_MAX_UPLOAD_MB=5
# Required for real job search. Obtain your own credentials from developer.adzuna.com.
# Keep them here on the server, never in frontend/VITE_* variables.
ADZUNA_APP_ID=
ADZUNA_API_KEY=
ADZUNA_COUNTRY=in
JOB_TIMEOUT_SECONDS=15
JOB_MAX_RETRIES=1
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=180
