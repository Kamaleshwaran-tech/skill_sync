ENVIRONMENT=development
DEBUG=true
APP_NAME=SkillSync AI
APP_VERSION=0.1.0
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- Database Configuration ---
# MySQL 8 (Default / Production):
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/skillsync_ai
# SQLite (Local Embedded Fallback):
# DATABASE_URL=sqlite:///./skillsync_ai.db
DB_ECHO=false

# --- CORS & Network ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOW_CREDENTIALS=true

# --- Security & JWT Authentication ---
JWT_SECRET_KEY=skillsync-super-secure-jwt-secret-key-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- AI Service (Google Gemini API) ---
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
SEMANTIC_EMBEDDING_ENABLED=true
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=20.0

# --- Live Job Ingestion API (Adzuna) ---
# Get your free developer credentials at: https://developer.adzuna.com/
JOB_INGESTION_ENABLED=true
JOB_PROVIDERS=adzuna
ADZUNA_APP_ID=
ADZUNA_API_KEY=
ADZUNA_BASE_URL=https://api.adzuna.com/v1/api/jobs
ADZUNA_COUNTRY=us
JOB_TIMEOUT_SECONDS=15.0
JOB_REFRESH_MINUTES=30
JOB_REFRESH_LIMIT=100
JOB_SCHEDULER_ENABLED=true

# --- Optional Secondary Job API ---
ADDITIONAL_JOB_PROVIDER_URL=
ADDITIONAL_JOB_PROVIDER_API_KEY=

# --- File Storage & Rate Limiting ---
RESUME_STORAGE_DIR=./storage/resumes
RESUME_MAX_UPLOAD_MB=5
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=120
